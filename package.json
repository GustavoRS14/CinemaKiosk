{
  "name": "totem-design-system-storybook",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "storybook": "storybook dev --port 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "electron": "npm run build-storybook && electron .",
    "electron:dev": "electron .",
    "generate:app-icon": "node scripts/generate-application-icon.cjs",
    "dist:windows": "npm run generate:app-icon && npm run build-storybook && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.totem.cinema",
    "productName": "Totem Cinema",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "build/ApplicationLogo.ico",
      "Assets/BrandLogo/**/*",
      "dist/**/*",
      "storybook-static/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/ApplicationLogo.ico"
    },
    "nsis": {
      "installerIcon": "build/ApplicationLogo.ico",
      "uninstallerIcon": "build/ApplicationLogo.ico",
      "installerHeaderIcon": "build/ApplicationLogo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "storybook": "^10.6.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.0",
    "vite-plugin-svgr": "^5.2.0"
  }
}
